# MongoDB Atlas DNS Seedlist SRV Connection URI
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster credentials
# NEVER commit your actual password or connection string to version control
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority

# Target Database Name (as specified for Case Study Q3)
DB_NAME=StudentDB

# Server Listening Port (Default: 5000)
PORT=5000

# Application Environment Mode (development | production)
NODE_ENV=development
